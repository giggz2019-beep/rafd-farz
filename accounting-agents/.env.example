# Copy to .env on the server, fill in, then: chmod 600 .env   (never commit .env)

# --- public address of the approval dashboard (TLS is automatic via Caddy)
DOMAIN=accounting.example.com

# --- database / cache (generate each with: openssl rand -hex 32)
DB_ADMIN_PASSWORD=
APP_DB_ROLE=rafd_app
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- Claude API (billed per use; separate from any Claude / Claude Code subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACKS=true

# --- company facts
COMPANY_VAT_REGISTERED=false
# Purchases above this (SAR incl. VAT) need an owner-approved purchase order + recorded receipt
PURCHASE_APPROVAL_THRESHOLD=1000

# --- access tokens: store only the SHA-256 of each token here
# generate:  TOKEN=$(openssl rand -hex 32); echo "$TOKEN"; printf %s "$TOKEN" | sha256sum
OWNER_TOKEN_SHA256=
SERVICE_TOKEN_SHA256=

# --- encryption key for secrets stored in the database
# generate:  docker compose run --rm api python -m app.security.secrets
SECRETS_MASTER_KEY=

# --- Daftra (read-only). Leave empty until each value is confirmed in docs.daftara.dev
DAFTRA_BASE_URL=
DAFTRA_JOURNALS_PATH=
DAFTRA_AUTH_HEADER=
DAFTRA_API_KEY=
DAFTRA_WRITES_ENABLED=false
