# Copy to .env on the server, fill in, then: chmod 600 .env   (never commit .env)

# --- public address of the approval dashboard (TLS is automatic via Caddy)
DOMAIN=accounting.example.com

# --- database / cache (generate each with: openssl rand -hex 32)
DB_ADMIN_PASSWORD=
APP_DB_ROLE=rafd_app
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- Claude API (billed per use; separate from any Claude / Claude Code subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACKS=true

# --- company facts
# NOT VAT-registered (owner's decision, 2026-10-11). Change only after registering with ZATCA.
COMPANY_VAT_REGISTERED=false
# Warn the owner when rolling-12-month taxable sales reach this % of 187,500 / 375,000 SAR
VAT_THRESHOLD_WARN_PCT=80
# Purchases above this (SAR incl. VAT) need an owner-approved purchase order + recorded receipt
PURCHASE_APPROVAL_THRESHOLD=1000
# Invoices from one vendor without a PO issued fewer than this many days apart are summed against it
SPLIT_PURCHASE_WINDOW_DAYS=7

# --- access tokens: store only the SHA-256 of each token here
# generate:  TOKEN=$(openssl rand -hex 32); echo "$TOKEN"; printf %s "$TOKEN" | sha256sum
OWNER_TOKEN_SHA256=
SERVICE_TOKEN_SHA256=

# --- encryption key for secrets stored in the database
# generate:  docker compose run --rm api python -m app.security.secrets
SECRETS_MASTER_KEY=

# --- Daftra (read-only). Paths and header confirmed by a 200 from the live tenant on 2026-10-11
DAFTRA_BASE_URL=https://rafd1.daftra.com
DAFTRA_JOURNALS_PATH=/api2/journals.json
DAFTRA_AUTH_HEADER=APIKEY
# Settings -> API -> API Key in the rafd1 account. Never commit it.
DAFTRA_API_KEY=
DAFTRA_ACCOUNTS_PATH=/api2/journal_accounts.json
DAFTRA_INVOICES_PATH=/api2/invoices.json
DAFTRA_SUPPLIERS_PATH=/api2/suppliers.json
DAFTRA_EXPENSES_PATH=/api2/expenses.json
DAFTRA_WRITES_ENABLED=false
